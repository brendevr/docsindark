{
    "manifest_version": 3,
    "name": "DocsInDark",
    "version": "0.0.0",
    "description": "Dark Mode for Google Docs and Sheets.",
    "author": "Raymond Wang, brendevr",
    "content_scripts": [
        {
            "matches": [
                "*://docs.google.com/document/*",
                "*://docs.google.com/spreadsheets/*"
            ],
            "js": ["docs.bundle.js"],
            "css": ["global.bundle.css"]
        },
        {
            "matches": ["*://docs.google.com/drivesharing/*"],
            "all_frames": true,
            "js": ["docs.bundle.js"],
            "css": ["global.bundle.css"]
        }
    ],
    "action": {
        "default_title": "DocsInDark Settings",
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["docs.bundle.css"],
            "matches": ["*://docs.google.com/*"]
        }
    ],
    "icons": {
        "16": "assets/icons/docsafterdark_16.png",
        "48": "assets/icons/docsafterdark_48.png",
        "128": "assets/icons/docsafterdark_128.png"
    },
    "permissions": ["storage", "activeTab"],
    "browser_specific_settings": {
        "gecko": {
            "data_collection_permissions": {
                "required": ["none"]
            },
            "id": "{5dbd7bc6-a1f7-4e05-86eb-0cd17ca26d19}"
        }
    }
}
