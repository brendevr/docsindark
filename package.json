{
    "name": "docsindark",
    "version": "3.0.6",
    "description": "Dark Mode for Google Docs and Sheets.",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/archiver": "^7.0.0",
        "@types/node": "^25.0.9",
        "archiver": "^8.0.0",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "prettier": "^3.7.4",
        "sass": "^1.97.2",
        "stylelint": "^17.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.2",
        "web-ext": "^10.8.0",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brendevr/docsindark.git"
    },
    "author": "Raymond Wang",
    "bugs": {
        "url": "https://github.com/brendevr/docsindark/issues"
    },
    "scripts": {
        "build": "./build.sh",
        "check": "prettier --check . && eslint src && stylelint '**/*.scss'",
        "dev": "concurrently --names 'webpack,sass,sass,sass' --prefix-colors 'magenta,red,blue,yellow' 'webpack --watch' 'sass --watch src/scss/docs.scss build/docs.bundle.css' 'sass --watch src/scss/frame.scss build/frame.bundle.css' 'sass --watch src/scss/global.scss build/global.bundle.css'",
        "firefox": "web-ext run --config=web-ext.config.mjs",
        "fix:prettier": "prettier --write .",
        "fix:stylelint": "stylelint '**/*.scss' --fix"
    }
}
